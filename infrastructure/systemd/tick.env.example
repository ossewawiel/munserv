# Factory tick settings. scripts/install-factory-tick.sh copies this to
# ~/.config/munserv-factory/tick.env once and never overwrites it; edit that copy.
# Moving the tick to a server or to GitHub Actions changes this file only.

# Dollars (decisions D6): the tick stops dispatching once today's runs in
# ~/.local/state/munserv-factory/ticks.jsonl add up to DAILY_BUDGET_USD.
# Each story run gets the smaller of RUN_BUDGET_USD and what is left today.
DAILY_BUDGET_USD=10
RUN_BUDGET_USD=5
# The clerk's selection call, on Haiku; it also counts toward the daily budget.
SELECT_BUDGET_USD=0.50

STORIES_PER_TICK=2
STORY_MAX_TURNS=150
SELECT_MODEL=haiku
STORY_MODEL=sonnet

# Weekly retro (.claude/skills/factory-retro): the first tick on RETRO_WEEKDAY (`date +%u`,
# 1 = Monday) runs /factory-retro once, before the clerk; empty turns it off. It counts toward
# the daily budget.
RETRO_WEEKDAY=1
RETRO_BUDGET_USD=5
RETRO_MODEL=opus
RETRO_MAX_TURNS=120

# Hours (local time): ticks run from TICK_FIRST_HOUR:00 to TICK_LAST_HOUR:00, every
# TICK_EVERY_HOURS. The installer writes the timer's OnCalendar from these three; rerun
# scripts/install-factory-tick.sh after changing them. The script also skips ticks outside the window.
TICK_FIRST_HOUR=7
TICK_LAST_HOUR=21
TICK_EVERY_HOURS=2

# The checkout the tick fast-forwards and runs in. Empty means the checkout the installer ran from.
# It must sit on master with no uncommitted tracked changes, or the tick stops.
REPO_DIR=

# Cost meter (infrastructure/CLAUDE.md, "Cost meter"): Claude Code ignores the project-scope env
# block, so the tick exports it from here. Start the collector with the telemetry profile.
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_LOG_TOOL_DETAILS=1
