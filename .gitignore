# Dependencies
node_modules/
.pnpm-store/

# Build outputs
build/
dist/
out/
*.jar
# ...but the Gradle wrapper jar must be tracked, or clones cannot bootstrap Gradle
!**/gradle/wrapper/gradle-wrapper.jar

# Mobile (Flutter)
mobile/.dart_tool/
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/*.iml
mobile/.metadata
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/release/

# Web (React)
web/.next/
web/out/
web/coverage/

# Backend (Kotlin/Spring)
backend/.gradle/
backend/build/
backend/bin/
backend/out/
backend/*.log
backend/uploads/
# ...except the seed photos referenced by migration V009 (dev fixtures, not user uploads)
!backend/uploads/*-[0-9].jpg
!backend/uploads/*-[0-9]-thumb.jpg

# IDE
.idea/
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# Environment & secrets
.env
.env.local
.env.*.local
*.pem
*.key
**/application-local.yml

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier
~$*

# Logs
*.log
logs/

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Database
*.db
*.sqlite

# Docker
docker-compose.override.yml
.mcp.json
