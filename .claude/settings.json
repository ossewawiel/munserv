{
  "env": {
    "MCP_TIMEOUT": "60000"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(cd backend && ./gradlew *)",
      "Bash(pnpm *)",
      "Bash(cd web && pnpm *)",
      "Bash(npx vitest *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(cd mobile && flutter *)",
      "Bash(cd mobile && dart *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git worktree *)",
      "Bash(git rev-parse*)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(python3 scripts/validate-domain-language.py*)",
      "Bash(./scripts/validate-enum-sync.sh*)",
      "Bash(scripts/eyeball-up.sh *)",
      "Bash(python3 scripts/sync-board.py*)",
      "Bash(scripts/watch-ci.sh *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Read(./**)",
      "Edit(./backend/**)",
      "Edit(./web/**)",
      "Edit(./mobile/**)",
      "Edit(./specs/**)",
      "Edit(./domain/**)",
      "Write(./backend/**)",
      "Write(./web/**)",
      "Write(./mobile/**)",
      "Write(./specs/**)",
      "Write(./domain/**)",
      "Edit(./design/**)",
      "Write(./design/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/application-local.yml)",
      "Bash(git reset --hard*)",
      "Bash(git filter-repo*)",
      "Bash(rm -rf /*)",
      "Bash(docker compose down -v*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(docker compose down --volumes*)",
      "Read(./web/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "dart-flutter@dart-flutter": true,
    "context7@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "dart-flutter": {
      "source": {
        "source": "github",
        "repo": "flutter/agent-plugins"
      }
    }
  }
}
